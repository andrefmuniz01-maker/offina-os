# Ambiente da aplicação
NODE_ENV=production
# O host de produção normalmente injeta PORT; mantenha comentado se ele fizer isso.
# PORT=3000

# Supabase — a URL e a publishable key são incorporadas ao bundle do navegador.
# Nunca coloque SUPABASE_SERVICE_ROLE_KEY neste grupo VITE_ ou no frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Segredo usado somente no servidor para operações administrativas controladas,
# intake público validado e leitura de perfis quando o fluxo exigir.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Ponte de compatibilidade atual. O runtime ainda possui routers de domínio legados
# que usam MySQL/TiDB; não remover até o cutover Supabase documentado.
DATABASE_URL=mysql://user:password@host:3306/database

# Compatibilidade transitória do adaptador legado. Não usar para sessão humana nova.
# JWT_SECRET=replace_with_long_random_secret
# VITE_APP_ID=replace_with_app_id
# OAUTH_SERVER_URL=https://oauth.example.com
# OWNER_OPEN_ID=replace_with_owner_open_id

# Armazenamento legado usado por alguns fluxos de anexos de operações/orçamentos
# e por integrações internas. O intake público novo usa o Storage privado do Supabase.
# Configure os dois valores se esses fluxos forem mantidos no destino.
# BUILT_IN_FORGE_API_URL=https://forge.example.com
# BUILT_IN_FORGE_API_KEY=replace_with_server_only_forge_key

# Analytics é opcional e só deve ser configurado com endpoint HTTP(S) permitido.
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=replace-with-site-id
